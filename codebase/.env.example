# Copy file này thành codebase/.env rồi điền key. KHÔNG commit .env.

# --- OpenRouter (mặc định) ---
# Lấy key ở https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# --- Tuỳ chọn: đổi provider / model ---
# QA_BASE_URL=https://openrouter.ai/api/v1
# QA_MODEL=google/gemini-3.5-flash-lite
# QA_API_KEY_ENV=OPENROUTER_API_KEY
# QA_MAX_TOKENS=1200

# --- Dùng OpenAI thay thế ---
# QA_BASE_URL=https://api.openai.com/v1
# QA_API_KEY_ENV=OPENAI_API_KEY
# QA_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Dùng Gemini qua lớp OpenAI-compatible ---
# QA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# QA_API_KEY_ENV=GEMINI_API_KEY
# QA_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=...


# ============================================================
#  BẢN DISCORD — chỉ cần khi chạy discord_bot.py / seed_forum.py
#  Hướng dẫn từng bước: codebase/SETUP-DISCORD.md
# ============================================================

# Bắt buộc. Lấy ở Developer Portal -> Bot -> Reset Token.
# DISCORD_BOT_TOKEN=

# ID server test. Có thì lệnh slash hiện ngay, không có thì Discord sync
# global và có thể mất tới 1 tiếng mới thấy lệnh.
# DISCORD_GUILD_ID=

# Forum channel chứa #hỏi-đáp. Ưu tiên ID; không có thì dò theo tên.
# DISCORD_QNA_CHANNEL_ID=
# DISCORD_QNA_CHANNEL_NAME=hỏi-đáp

# Tên role để suy vai người trả lời. QUAN TRỌNG VỀ HÀNH VI: luật logistics
# trong system prompt ép confidence <= medium khi câu trả lời chỉ do học viên nói.
# DISCORD_TA_ROLES=TA,Trợ giảng
# DISCORD_LAB_COACH_ROLES=Lab Coach,Giảng viên,Mentor

# Tag đánh dấu đã xong. Trợ lý vẫn KHÔNG được tin nhãn này — nó chỉ đọc để
# đối chiếu, kết luận phải rút từ nội dung thread.
# DISCORD_SOLVED_TAGS=Solved,Đã giải quyết

# Ẩn danh tên người trước khi gửi sang LLM. Để 1 trừ khi có lý do rõ ràng.
# DISCORD_ANONYMIZE=1

# 0 = chỉ trả lời qua /hoi (đúng lát cắt trong spec).
# 1 = bot tự rep khi có post mới — TIỆN DEMO NHƯNG LÀ LÁT CẮT KHÁC.
# DISCORD_AUTO_REPLY=0

# Chu kỳ quét lại forum (phút) và trần chống nổ token.
# DISCORD_INDEX_REFRESH_MIN=15
# DISCORD_MAX_THREADS=300
# DISCORD_MAX_MESSAGES=60
# DISCORD_MAX_MSG_CHARS=1500
